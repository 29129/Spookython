{
  "name": "spookython",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de supervivencia y rutas en Manta para SpookyThon 2026",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "fire-drill:http": "node scripts/run-http-fire-drill.mjs",
    "web:serve": "node scripts/serve-web.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "fire-drill": "node scripts/run-fire-drill.mjs",
    "map:build": "node scripts/build-map.mjs",
    "map:validate": "node scripts/validate-map.mjs",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "map:build:local": "node scripts/build-map.mjs --nodes=600 --output=data/manta.graph.local-600.json",
    "map:validate:local": "node scripts/validate-map.mjs --nodes=600 --map=data/manta.graph.local-600.json",
    "fire-drill:local-map": "node scripts/run-fire-drill.mjs --map=data/manta.graph.local-600.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1146.1",
    "esbuild": "^0.25.11",
    "maplibre-gl": "^6.16.0",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.5.0"
  }
}
